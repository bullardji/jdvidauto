# =============================================================================
# n8n Configuration
# =============================================================================
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http

# Change this to a strong random string
N8N_ENCRYPTION_KEY=change-me-to-a-random-string

# Basic auth for n8n web UI
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=change-me

# Timezone for scheduling posts
GENERIC_TIMEZONE=America/Los_Angeles

# =============================================================================
# PostgreSQL (n8n backend database)
# =============================================================================
POSTGRES_USER=n8n
POSTGRES_PASSWORD=change-me-db-password
POSTGRES_DB=n8n
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# =============================================================================
# Redis (queue mode for webhooks)
# =============================================================================
REDIS_HOST=redis
REDIS_PORT=6379

# =============================================================================
# Social Platform API Keys
# =============================================================================

# Instagram / Meta Graph API
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=

# TikTok
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ACCESS_TOKEN=

# YouTube (Google OAuth2)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
YOUTUBE_CHANNEL_ID=UCBI-XSaTS8OHvKElrz-5eUw

# =============================================================================
# Clip Processing
# =============================================================================

# Minimum episode number allowed (inclusive)
MIN_EPISODE_NUMBER=343

# Watermark settings
WATERMARK_PATH=/data/watermark/julian_dorey_watermark.png
WATERMARK_SCALE=0.25
WATERMARK_OPACITY=0.8

# Julian's main YouTube channel (for bio links)
JULIAN_YOUTUBE_URL=https://www.youtube.com/@JulianDorey/

# =============================================================================
# Storage paths (inside Docker containers)
# =============================================================================
CLIPS_INPUT_DIR=/data/clips-input
CLIPS_PROCESSED_DIR=/data/clips-processed
CLIPS_POSTED_DIR=/data/clips-posted
